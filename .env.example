# Used when running Rocky outside Docker (docker compose sets its own values).
ROCKY_DATABASE_URL=postgres://rocky:rocky@localhost:5432/rocky?sslmode=disable

# Optional. Leave empty to run without Redis; Rocky stays correct (ADR 0002).
ROCKY_REDIS_URL=redis://localhost:6379/0

ROCKY_API_ADDR=:8080
# debug | info | warn | error
ROCKY_LOG_LEVEL=info
# text | json
ROCKY_LOG_FORMAT=text
# API: time to finish in-flight requests. Worker: grace period for in-flight jobs.
ROCKY_SHUTDOWN_TIMEOUT=15s

# Worker. ROCKY_WORKER_ID defaults to hostname plus a random suffix.
ROCKY_WORKER_ID=
ROCKY_WORKER_QUEUES=default
ROCKY_WORKER_CONCURRENCY=10
ROCKY_WORKER_POLL_INTERVAL=1s
# Leases are renewed every TTL/3; a crashed worker's jobs are recovered about one TTL later.
ROCKY_WORKER_LEASE_TTL=30s

# Retry delay after attempt n: RETRY_BASE * 2^(n-1), ±20% jitter, capped at RETRY_MAX.
ROCKY_RETRY_BASE=2s
ROCKY_RETRY_MAX=1h

# Integration tests run only when this is set. Each test uses its own temporary schema.
ROCKY_TEST_DATABASE_URL=postgres://rocky:rocky@localhost:5432/rocky?sslmode=disable
